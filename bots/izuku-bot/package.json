{
  "name": "izuku-bot",
  "version": "1.0.0",
  "description": "Bot de WhatsApp (Baileys) estilo Izuku Midoriya/Deku: stickers, packs y menú heroico Plus Ultra. Compatible con Termux.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "izuku-bot": "src/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node scripts/boot.js",
    "setup": "node scripts/setup-config.js",
    "qr": "node scripts/boot.js --qr",
    "pair": "node scripts/boot.js --pair",
    "terminal": "node scripts/terminal.js",
    "doctor": "node src/doctor.js",
    "test": "node --test tests/*.test.js",
    "emojimix:sync": "node src/tools/sync-emojimix.js",
    "verify": "node scripts/verify-commands.js",
    "ai:test": "node scripts/test-ai.js",
    "search:test": "node scripts/test-search.js",
    "selftest": "node scripts/selftest.js"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "bot",
    "termux",
    "stickers",
    "izuku",
    "deku"
  ],
  "license": "MIT",
  "dependencies": {
    "@itsliaaa/baileys": "^0.3.18-final",
    "node-webpmux": "^3.2.1",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0"
  },
  "optionalDependencies": {
    "qrcode": "^1.5.4"
  },
  "author": "Izuku Bot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyanvalentinmail-prog/MultiBot.git",
    "directory": "bots/izuku-bot"
  }
}
