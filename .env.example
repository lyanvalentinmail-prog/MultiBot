# Optional when running locally; Render Blueprint provisions DATABASE_URL.
PORT=3000
MULTIBOT_DATA_DIR=./data
# DATABASE_URL=postgresql://user:password@localhost:5432/multibot
# Set to true only if your PostgreSQL host requires TLS.
PGSSL=false

# Web bot runtime: Render Blueprint enables it, but restricts control to this allowlist.
# Add the same email used by your MultiBot account in Render's environment settings.
WEB_RUNTIME_ENABLED=false
WEB_RUNTIME_ADMIN_EMAILS=

# Optional Universal Bot settings passed only to its child process.
# The phone number is the WhatsApp bot owner, not the Pairing Code target number.
BOT_UNIVERSAL_BOT_OWNER_PHONE=
BOT_UNIVERSAL_BOT_OWNER_NAME=MultiBot Owner
BOT_UNIVERSAL_BOT_OWNER_LID=
# Optional API credentials; never commit real values.
BOT_UNIVERSAL_BOT_API_VREDEN_KEY=
BOT_UNIVERSAL_BOT_API_DELIRIUS_KEY=
BOT_UNIVERSAL_BOT_API_ZENZXZ_KEY=
BOT_UNIVERSAL_BOT_API_SIPUTZX_KEY=
