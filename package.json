{
  "name": "multibot",
  "version": "1.1.0",
  "private": true,
  "description": "Repositorio MultiBot y panel web para gestionar configuraciones de bots de WhatsApp.",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve-web.js",
    "web": "node scripts/serve-web.js",
    "dev": "NODE_ENV=development node scripts/serve-web.js",
    "check": "node --check scripts/serve-web.js && node --check web/app.js",
    "test": "npm run check && node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "keywords": [
    "whatsapp",
    "baileys",
